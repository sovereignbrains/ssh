{
  "name": "ssh-desktop-app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": {
    "name": "Sovereign Brains",
    "email": "info@sovereignbrains.com"
  },
  "homepage": "https://github.com/sovereignbrains/ssh",
  "keywords": ["ssh", "client", "terminal"],
  "license": "ISC",
  "description": "SSH Client Desktop Application",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sovereignbrains.ssh",
    "productName": "SSH Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "icon.icns"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "icon.png",
      "category": "Utility",
      "maintainer": "Sovereign Brains <info@sovereignbrains.com>"
    }
  }
}
